{
  // vitest's typecheck pass: src plus every test file (runtime *.test.ts,
  // *.test-d.ts type tests, and helpers). The base tsconfig only includes
  // src, so without this the tests themselves were never type-checked.
  "extends": "./tsconfig.json",
  "compilerOptions": { "rootDir": "." },
  "include": ["src/**/*", "test/**/*.ts"]
}
