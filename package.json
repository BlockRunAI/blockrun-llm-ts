{
  "name": "@blockrun/llm",
  "version": "3.13.6",
  "type": "module",
  "description": "BlockRun SDK - AI chat, media and tools with API key account billing or x402 USDC on Solana and Base",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "llm",
    "ai",
    "x402",
    "base",
    "solana",
    "usdc",
    "micropayments",
    "openai",
    "claude",
    "gemini",
    "blockchain"
  ],
  "author": "BlockRun <hello@blockrun.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlockRunAI/blockrun-llm-ts"
  },
  "homepage": "https://blockrun.ai",
  "bugs": {
    "url": "https://github.com/BlockRunAI/blockrun-llm-ts/issues"
  },
  "dependencies": {
    "bs58": "^6.0.0",
    "viem": "^2.56.3"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.123.0"
  },
  "devDependencies": {
    "@blockrun/core": "^0.1.0",
    "@blockrun/router-core": "https://codeload.github.com/BlockRunAI/router-core/tar.gz/814fd3b6bc7880a84bbe030bd08c98e8670031e7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "uuid@<11.1.1": "^11.1.1",
      "esbuild@<0.28.1": "^0.28.1"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "peerDependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4"
  },
  "peerDependenciesMeta": {
    "@solana/spl-token": {
      "optional": true
    },
    "@solana/web3.js": {
      "optional": true
    }
  }
}
